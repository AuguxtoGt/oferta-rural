# ============================================================================
# CONFIGURACAO DE AMBIENTE (.env) - AREA DE MEMBROS REGULARIZE RURAL
# Copie este arquivo para .env e preencha com os seus dados (nunca envie chaves no chat)
# ============================================================================

# 1. SUPABASE (Banco de Dados de Alunos e Webhook)
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=PREENCHA_COM_SUA_SERVICE_ROLE_KEY_NO_ENV

# 2. SEGURANCA DE AUTENTICACAO (Gere AUTH_SECRET com: openssl rand -hex 32)
AUTH_SECRET=PREENCHA_COM_64_CARACTERES_HEX_ALEATORIOS_UNICOS
DEFAULT_STUDENT_PASSWORD=PREENCHA_SENHA_INICIAL_DOS_ALUNOS
ADMIN_EMAIL=seu-email-admin@dominio.com
ADMIN_PASSWORD=PREENCHA_SENHA_FORTE_EXCLUSIVA_DO_ADMIN

# 3. SEGURANCA DO WEBHOOK (Gere com: openssl rand -hex 24 e use em /api/webhook?token=...)
WEBHOOK_SECRET=PREENCHA_TOKEN_ALEATORIO_EXCLUSIVO_DO_WEBHOOK

# 4. LINKS DE CHECKOUT PARA DESTRAVAR CADEADOS DENTRO DA AREA DE MEMBROS
CHECKOUT_PRINCIPAL_URL=https://pay.novarkbr.com/jxiib47t
CHECKOUT_PRINCIPAL_URL_37=https://pay.novarkbr.com/kg1a7jgt
CHECKOUT_ENTENDA_URL=https://pay.novarkbr.com/agwfds26
CHECKOUT_OB1_URL_CONSULTOR_RURAL=https://pay.novarkbr.com/t61jpbxl
CHECKOUT_OB2_URL_MODELOS_PRONTOS=https://pay.novarkbr.com/ty2kxpf2
CHECKOUT_OB3_URL_GUIA_SERVICOS=https://pay.novarkbr.com/483r78iu
CHECKOUT_COMBO_3OBS_URL=https://pay.novarkbr.com/fotl08p9
CHECKOUT_UPSELL_URL=https://pay.novarkbr.com/p0ptqz86
CHECKOUT_IA_URL=https://pay.novarkbr.com/p0ptqz86

# 5. CHAVE DE API PARA O AGENTE DE IA "CONSULTOR RURAL IA 24H" (Opcional - lancamento futuro)
ENABLE_AI_CONSULTANT=false
GEMINI_API_KEY=
OPENAI_API_KEY=

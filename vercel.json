{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/entenda", "destination": "/entenda.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(webp|png|jpg|jpeg|svg|mp3)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
